# ─── YouTube Data API ─────────────────────────────────────────────────────────
# Go to Google Cloud Console → Enable YouTube Data API v3 → Create API Key
YOUTUBE_API_KEY="paste_your_youtube_api_key_here"

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="yt_stats"
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/yt_stats"

# ─── AWS Cognito (Authentication) ────────────────────────────────────────────
# AWS Console → Cognito → User Pools → your pool
COGNITO_USER_POOL_ID="us-east-1_XXXXXXXXX"
COGNITO_CLIENT_ID="your-app-client-id-here"
AWS_REGION="us-east-1"
# Cognito → App integration → Domain
COGNITO_DOMAIN="your-pool.auth.us-east-1.amazoncognito.com"

# ─── AWS IAM (DynamoDB access — chat history & saved channels) ────────────────
# AWS Console → IAM → Users → your user → Security credentials → Create access key
AWS_ACCESS_KEY_ID="your-iam-access-key-id"
AWS_SECRET_ACCESS_KEY="your-iam-secret-access-key"

# ─── Google Gemini AI (Chatbot) ───────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
